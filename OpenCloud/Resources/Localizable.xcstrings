    "Files and folders marked as Available Offline will become unavailable. They will be re-downloaded next time you log into your account (connectivity required)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien und Ordner, die als „Offline verfügbar“ markiert sind, werden nicht mehr verfügbar sein. Sie werden beim nächsten Anmelden wieder heruntergeladen (Internetverbindung erforderlich)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files and folders marked as Available Offline will become unavailable. They will be re-downloaded next time you log into your account (connectivity required)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers et dossiers marqués comme disponibles hors ligne ne seront plus disponibles. Ils seront téléchargés à nouveau la prochaine fois que vous vous connecterez à votre compte (connectivité exigée)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden en mappen gemarkeerd als Offline beschikbaar worden niet meer beschikbaar. Ze worden de volgende keer dat u inlogt op uw account opnieuw gedownload (verbinding vereist)."
          }
        }
      }
    },
