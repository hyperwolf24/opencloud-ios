    },
    "If you would like background media uploads to be more reliable, you should enable background location updates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie möchten, dass Hintergrund-Medienuploads zuverlässiger sind, sollten Sie die Hintergrundstandortaktualisierungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you would like background media uploads to be more reliable, you should enable background location updates."
